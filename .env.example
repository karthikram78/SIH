# ─────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase in production:
# DATABASE_URL="postgres://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgres://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────────
# Authentication Secrets
# ─────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ─────────────────────────────────────────────────────────────────
# OTP Configuration (MSG91)
# ─────────────────────────────────────────────────────────────────
OTP_DEV_MODE=true
MSG91_AUTH_KEY="YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID="YOUR_MSG91_TEMPLATE_ID"
MSG91_SENDER_ID="AVADIC"

# ─────────────────────────────────────────────────────────────────
# Maps & AI Configuration (Optional)
# ─────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
AI_API_KEY="YOUR_GEMINI_OR_OPENAI_KEY"
